int[][] board = new int[9][9];
boolean[][] fixed = new boolean[9][9];
int cellSize = 50;
int selectedRow = -1;
int selectedCol = -1;
boolean cellSelected = false;
boolean gameWon = false;

void setup() {
  size(450, 450);
  noLoop();
  generateSudoku();
}
void draw() {
  background(255);
  drawGrid();
  drawNumbers();
  
  if (gameWon) {
    fill(0, 255, 0);
    textSize(48);
    textAlign(CENTER, CENTER);
    text("WIN", width / 2, height / 2);
  }
}
void drawGrid() {
  stroke(0);
  for (int i = 0; i <= 9; i++) {
    strokeWeight((i % 3 == 0) ? 4 : 1);
    line(i * cellSize, 0, i * cellSize, 9 * cellSize);
    line(0, i * cellSize, 9 * cellSize, i * cellSize);
  }

  if (selectedRow >= 0 && selectedCol >= 0) {
    fill(200, 200, 255);
    rect(selectedCol * cellSize, selectedRow * cellSize, cellSize, cellSize);
  }
}
void drawNumbers() {
  textAlign(CENTER, CENTER);
  textSize(32);
  for (int row = 0; row < 9; row++) {
    for (int col = 0; col < 9; col++) {
      if (board[row][col] != 0) {
        fill(fixed[row][col] ? 0 : color(0, 0, 255));
        text(board[row][col], col * cellSize + cellSize / 2, row * cellSize + cellSize / 2);
      }
    }
  }
}
void mousePressed() {
  int row = mouseY / cellSize;
  int col = mouseX / cellSize;

  if (row >= 0 && row < 9 && col >= 0 && col < 9) {
    selectedRow = row;
    selectedCol = col;
    cellSelected = true;
    redraw();
  }
}
void keyPressed() {
  if (cellSelected && !fixed[selectedRow][selectedCol]) {
    if (key >= '1' && key <= '9') {
      board[selectedRow][selectedCol] = key - '0';
    } else if (key == BACKSPACE || key == DELETE) {
      board[selectedRow][selectedCol] = 0;
    }
    redraw();
  }
}
void generateSudoku() {
  fillBoard();
  removeNumbers();
}
