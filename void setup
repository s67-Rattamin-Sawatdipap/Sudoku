int[][] board = new int[9][9];
boolean[][] fixed = new boolean[9][9];
int cellSize = 50;
int selectedRow = -1;
int selectedCol = -1;
boolean cellSelected = false;
boolean gameWon = false;

void setup() {
  size(450, 450);
  noLoop();
  generateSudoku();
}
void draw() {
  background(255);
  drawGrid();
  drawNumbers();
  
  if (gameWon) {
    fill(0, 255, 0);
    textSize(48);
    textAlign(CENTER, CENTER);
    text("WIN", width / 2, height / 2);
  }
}

}
